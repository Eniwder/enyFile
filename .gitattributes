* text=auto eol=lf
# cmd.exe can miss labels (goto) in batch files with LF-only line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.ico binary
# Keep upstream sources distinct in reviews; unified-diff context has intentional spaces.
app/vendor/** linguist-vendored
app/vendor/patches/*.diff whitespace=-blank-at-eol
